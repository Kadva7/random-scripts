SUBJECT='pb111'
WEEK_REGEX='[0-1][0-9]'
ASSIGNMENTS='s[1-3]_[a-f]_\w+'
TO_SUBMIT_REGEX="(\b+($WEEK_REGEX|$ASSIGNMENTS))+"
ACTIVATE_FOR="submit$TO_SUBMIT_REGEX"
LAST_COMMIT="$(git log -1 --online)"

MATCH=$(grep -wEo "$ACTIVATE_FOR" "$LAST_COMMIT")

if command -v "$SUBJECT" 2>&1 >/dev/null && [ -n "$MATCH" ]
then
        # yes, sed can also be used, but grep is already smth used so, less deps
        TO_SUBMIT=${grep -wEo "$TO_SUBMIT_REGEX" "$MATCH"}

        for $submission in $TO_SUBMIT
        do
            echo "Submitting $submission"
            if [ -n "$submission" ] && ! $SUBJECT submit --wait "$submission"; then
                echo "Error while submitting, exiting…"
                # break
                exit 1
            fi
        done
        echo "Submitted all successfully!"
fi
